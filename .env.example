# Copy to .env.local (gitignored) or let `npm run convex` write it for you.
# Deployment used by `npx convex dev`, e.g. dev:watchful-greyhound-256
CONVEX_DEPLOYMENT=

# Public Convex URLs, inlined into the client bundle by Expo
EXPO_PUBLIC_CONVEX_URL=https://watchful-greyhound-256.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://watchful-greyhound-256.convex.site

# Demo builds only: "lat,lng" used when the device has no San Francisco location
# (for example a cloud simulator). Leave empty for real builds.
EXPO_PUBLIC_DEMO_LOCATION=

# Never commit CONVEX_DEPLOY_KEY; set it in your shell or CI secrets instead.
